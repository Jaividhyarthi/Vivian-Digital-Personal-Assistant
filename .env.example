# Generate a random owner token (at least 32 characters); enter it in the sign-in screen.
VIVIAN_API_TOKEN=
# Local HTTP development only. Use 1 behind HTTPS in production.
VIVIAN_COOKIE_SECURE=0
VIVIAN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VIVIAN_TIMEZONE=Asia/Kolkata
# Credentials deferred: core workspace works without these.
OPENAI_API_KEY=
# Choose an API model available to your project; no model is hardcoded.
VIVIAN_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=VnvaVe7ctz87lJj9udKY
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional absolute storage paths; both API and worker must use the same paths.
# VIVIAN_DB=/data/vivian.db
# VIVIAN_FILES=/data/files
